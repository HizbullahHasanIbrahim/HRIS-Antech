    "/auth/refresh": { "post": { "summary": "Refresh token", "tags": ["Auth"], "responses": { "200": { "description": "New token" } } } },

    "/dashboard/stats": { "get": { "summary": "Dashboard aggregate stats", "tags": ["Dashboard"], "responses": { "200": { "description": "SDM, cuti, lembur, pensiun stats" } } } },

