    "/overtime-requests/{id}/reject": { "post": { "summary": "Reject overtime", "tags": ["Attendance"], "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "Rejected" } } } },
