        "summary": "Login", "tags": ["Auth"], "security": [],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["username","password"], "properties": { "username": { "type": "string" }, "password": { "type": "string" }, "remember": { "type": "boolean" } } } } } },
        "responses": { "200": { "description": "Token issued" }, "422": { "description": "Invalid credentials" } }
      }
    },
