    "/upload/cv": { "post": { "summary": "Upload applicant CV", "tags": ["Upload"], "security": [], "requestBody": { "content": { "multipart/form-data": { "schema": { "type": "object", "properties": { "applicant_id": { "type": "integer" }, "file": { "type": "string", "format": "binary" } } } } } }, "responses": { "200": { "description": "Uploaded" } } } },
